# Copy this file to .env and replace the placeholders with real values.
# For Gmail SMTP, use an app password with 2-step verification enabled.
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/cineweb
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN_SECONDS=28800
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Administrador
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app-do-gmail
MAIL_FROM=seu-email@gmail.com
